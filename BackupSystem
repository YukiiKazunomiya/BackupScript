#Requires -Version 5.1

# ============================================================
# KONFIGURASI UTAMA — EDIT SESUAI KEBUTUHAN
# ============================================================

$Config = @{

    # ── Folder Backup ────────────────────────────────────────
    # Daftar nama sub-folder dari profil user yang akan dibackup.
    # Tambah atau hapus sesuai kebutuhan. Contoh tambahan: "Videos", "Music"
    BackupFolders     = @(
        "Documents",
        "Desktop",
        "Pictures",
        "Downloads",
        "Videos"
    )

    # Lokasi penyimpanan hasil backup di PC
    BackupDestination = "C:\BackupData"

    # Berapa hari backup lama disimpan sebelum dihapus otomatis
    MaxBackupAge      = 30

    # ── Email Notifikasi ─────────────────────────────────────
    EmailEnabled      = $true
    SmtpServer        = "smtp.gmail.com"
    SmtpPort          = 587
    EmailFrom         = "yukiidesu@gmail.com"   # Alamat pengirim (Gmail kamu)
    EmailTo           = "yukiidesu@gmail.com"   # Alamat tujuan
    # Gunakan App Password Google, BUKAN password Gmail biasa!
    # Cara buat: myaccount.google.com > Security > App Passwords
    EmailPassword     = ""

    # Batas ukuran attachment ZIP yang dikirim via email (MB)
    # Jika backup lebih besar dari ini, ZIP tidak dilampirkan (hanya log)
    MaxEmailAttachmentMB = 20

    # ── Auto Update Software (via Chocolatey) ────────────────
    AutoUpdateEnabled = $false
    SoftwareList      = @("googlechrome", "adobereader", "7zip")

    # ── Logging ──────────────────────────────────────────────
    LogFolder         = "C:\BackupLogs"
    LogRetentionDays  = 90
}

# ============================================================
# INTERNAL — JANGAN DIUBAH
# ============================================================
$Script:LogFile = $null
$Script:Stats   = @{ FileCount = 0; TotalSizeMB = 0; Duration = 0; Errors = 0 }

# ============================================================
# WATERMARK
# ============================================================
function Show-Watermark {
    Clear-Host
    Write-Host ""
    Write-Host "  +==================================================+" -ForegroundColor Magenta
    Write-Host "  |    Backup & Maintenance Automation System        |" -ForegroundColor Cyan
    Write-Host "  |    Version 2.0  -  (c) 2025 YukiiKazunomiya     |" -ForegroundColor Magenta
    Write-Host "  +==================================================+" -ForegroundColor Magenta
    Write-Host ""
}

# ============================================================
# LOGGING
# ============================================================
function Write-Log {
    param(
        [string]$Message,
        [ValidateSet('INFO', 'WARNING', 'ERROR', 'SUCCESS')]
        [string]$Level = 'INFO'
    )

    $Timestamp  = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogMessage = "[$Timestamp] [$Level] $Message"

    # Pastikan folder log ada
    if (!(Test-Path $Config.LogFolder)) {
        New-Item -ItemType Directory -Path $Config.LogFolder -Force | Out-Null
    }

    # Inisialisasi path log file jika belum ada
    if ($null -eq $Script:LogFile) {
        $Script:LogFile = Join-Path $Config.LogFolder "Backup_$(Get-Date -Format 'yyyyMMdd').log"
    }

    Add-Content -Path $Script:LogFile -Value $LogMessage -Encoding UTF8

    $Color = switch ($Level) {
        'INFO'    { 'Cyan' }
        'WARNING' { 'Yellow' }
        'ERROR'   { 'Red' }
        'SUCCESS' { 'Green' }
    }

    Write-Host $LogMessage -ForegroundColor $Color

    if ($Level -eq 'ERROR') { $Script:Stats.Errors++ }
}

# ============================================================
# TAMPILKAN KONFIGURASI
# ============================================================
function Show-Configuration {
    Write-Log "====== KONFIGURASI SYSTEM ======" -Level INFO
    Write-Log "User aktif        : $env:USERNAME" -Level INFO
    Write-Log "Backup destination: $($Config.BackupDestination)" -Level INFO
    Write-Log "Max backup age    : $($Config.MaxBackupAge) hari" -Level INFO
    Write-Log "Email notifikasi  : $(if ($Config.EmailEnabled) {'ENABLED'} else {'DISABLED'})" -Level INFO
    Write-Log "Auto update SW    : $(if ($Config.AutoUpdateEnabled) {'ENABLED'} else {'DISABLED'})" -Level INFO
    Write-Log "Log retention     : $($Config.LogRetentionDays) hari" -Level INFO
    Write-Log "Folder yang akan dibackup:" -Level INFO
    foreach ($Folder in $Config.BackupFolders) {
        $FullPath = Join-Path $env:USERPROFILE $Folder
        $Exists   = if (Test-Path $FullPath) { "Ada" } else { "TIDAK DITEMUKAN" }
        Write-Log "  - $FullPath  [$Exists]" -Level INFO
    }
    Write-Log "================================" -Level INFO
    Write-Host ""
}

# ============================================================
# PROSES BACKUP
# ============================================================
function Start-BackupProcess {
    Write-Log "====== MEMULAI BACKUP ======" -Level INFO

    try {
        # Buat folder tujuan backup
        if (!(Test-Path $Config.BackupDestination)) {
            New-Item -ItemType Directory -Path $Config.BackupDestination -Force | Out-Null
        }

        $BackupTimestamp = Get-Date -Format "yyyyMMdd_HHmmss"
        $BackupPath      = Join-Path $Config.BackupDestination "Backup_$BackupTimestamp"
        New-Item -ItemType Directory -Path $BackupPath -Force | Out-Null

        $StartTime       = Get-Date
        $TotalFiles      = 0
        $TotalBytes      = 0
        $FoldersBackedup = 0

        # Loop setiap folder yang dikonfigurasi
        foreach ($FolderName in $Config.BackupFolders) {
            $SourcePath = Join-Path $env:USERPROFILE $FolderName

            if (!(Test-Path $SourcePath)) {
                Write-Log "Folder tidak ditemukan, dilewati: $SourcePath" -Level WARNING
                continue
            }

            $DestPath = Join-Path $BackupPath $FolderName
            New-Item -ItemType Directory -Path $DestPath -Force | Out-Null

            # Hitung ukuran folder
            $FolderFiles  = Get-ChildItem -Path $SourcePath -Recurse -File -ErrorAction SilentlyContinue
            $FolderSize   = ($FolderFiles | Measure-Object -Property Length -Sum).Sum
            $FolderSizeMB = [math]::Round(($FolderSize / 1MB), 2)

            Write-Log "Membackup $FolderName ($($FolderFiles.Count) file, $FolderSizeMB MB)..." -Level INFO

            # Copy file dengan progress bar
            $FileIndex = 0
            foreach ($File in $FolderFiles) {
                $FileIndex++
                $RelativePath = $File.FullName.Substring($SourcePath.Length)
                $DestFile     = Join-Path $DestPath $RelativePath
                $DestDir      = Split-Path $DestFile -Parent

                if (!(Test-Path $DestDir)) {
                    New-Item -ItemType Directory -Path $DestDir -Force | Out-Null
                }

                try {
                    Copy-Item -Path $File.FullName -Destination $DestFile -Force
                }
                catch {
                    Write-Log "Gagal copy: $($File.Name) - $($_.Exception.Message)" -Level WARNING
                }

                # Update progress bar setiap 10 file
                if ($FileIndex % 10 -eq 0 -or $FileIndex -eq $FolderFiles.Count) {
                    $Pct = [math]::Round(($FileIndex / [math]::Max($FolderFiles.Count, 1)) * 100)
                    Write-Progress -Activity "Backup $FolderName" `
                                   -Status "$FileIndex / $($FolderFiles.Count) file ($Pct%)" `
                                   -PercentComplete $Pct
                }
            }
            Write-Progress -Activity "Backup $FolderName" -Completed

            $TotalFiles  += $FolderFiles.Count
            $TotalBytes  += $FolderSize
            $FoldersBackedup++
            Write-Log "$FolderName selesai dibackup." -Level SUCCESS
        }

        $Duration = [math]::Round(((Get-Date) - $StartTime).TotalSeconds, 2)

        if ($FoldersBackedup -eq 0) {
            Write-Log "Tidak ada folder yang berhasil dibackup. Periksa konfigurasi BackupFolders." -Level ERROR
            Remove-Item -Path $BackupPath -Recurse -Force -ErrorAction SilentlyContinue
            return $null
        }

        # Simpan statistik
        $Script:Stats.FileCount   = $TotalFiles
        $Script:Stats.TotalSizeMB = [math]::Round($TotalBytes / 1MB, 2)
        $Script:Stats.Duration    = $Duration

        Write-Log "Semua folder selesai: $TotalFiles file, $($Script:Stats.TotalSizeMB) MB, dalam $Duration detik" -Level SUCCESS

        # Kompres ke ZIP
        Write-Log "Mengompres backup ke ZIP..." -Level INFO
        $ZipPath = "$BackupPath.zip"
        Compress-Archive -Path "$BackupPath\*" -DestinationPath $ZipPath -Force
        Remove-Item -Path $BackupPath -Recurse -Force

        $ZipSizeMB = [math]::Round((Get-Item $ZipPath).Length / 1MB, 2)
        Write-Log "ZIP berhasil dibuat: $ZipPath ($ZipSizeMB MB)" -Level SUCCESS

        return $ZipPath
    }
    catch {
        Write-Log "ERROR kritis saat backup: $($_.Exception.Message)" -Level ERROR
        return $null
    }
}

# ============================================================
# KIRIM EMAIL NOTIFIKASI (SUPPORT MULTI-ATTACHMENT)
# ============================================================
function Send-NotificationEmail {
    param(
        [string]$Subject,
        [string]$Body,
        [string[]]$AttachmentPaths = @()
    )

    if (-not $Config.EmailEnabled) {
        Write-Log "Email notifikasi DISABLED, dilewati." -Level WARNING
        return
    }

    if ([string]::IsNullOrWhiteSpace($Config.EmailPassword)) {
        Write-Log "EmailPassword kosong! Isi App Password Gmail di konfigurasi." -Level ERROR
        return
    }

    try {
        Write-Log "Mengirim email ke $($Config.EmailTo)..." -Level INFO

        $smtp             = New-Object System.Net.Mail.SmtpClient($Config.SmtpServer, $Config.SmtpPort)
        $smtp.EnableSsl   = $true
        $smtp.Credentials = New-Object System.Net.NetworkCredential($Config.EmailFrom, $Config.EmailPassword)

        $mail            = New-Object System.Net.Mail.MailMessage
        $mail.From       = $Config.EmailFrom
        $mail.To.Add($Config.EmailTo)
        $mail.Subject    = $Subject
        $mail.Body       = $Body
        $mail.IsBodyHtml = $false

        # Tambahkan semua attachment yang valid
        $AttachedCount = 0
        foreach ($Path in $AttachmentPaths) {
            if (![string]::IsNullOrWhiteSpace($Path) -and (Test-Path $Path)) {
                $mail.Attachments.Add((New-Object System.Net.Mail.Attachment($Path)))
                Write-Log "Lampiran: $(Split-Path $Path -Leaf)" -Level INFO
                $AttachedCount++
            }
        }

        $smtp.Send($mail)
        $mail.Dispose()

        Write-Log "Email berhasil dikirim dengan $AttachedCount lampiran." -Level SUCCESS
    }
    catch {
        Write-Log "ERROR saat mengirim email: $($_.Exception.Message)" -Level ERROR
    }
}

# ============================================================
# HAPUS BACKUP LAMA
# ============================================================
function Remove-OldBackups {
    Write-Log "====== HAPUS BACKUP LAMA ======" -Level INFO
    try {
        if (!(Test-Path $Config.BackupDestination)) { return }

        $CutoffDate = (Get-Date).AddDays(-$Config.MaxBackupAge)
        Write-Log "Batas tanggal: $($CutoffDate.ToString('yyyy-MM-dd'))" -Level INFO

        $OldBackups = Get-ChildItem -Path $Config.BackupDestination -Filter "Backup_*.zip" |
                      Where-Object { $_.LastWriteTime -lt $CutoffDate }

        if ($OldBackups.Count -eq 0) {
            Write-Log "Tidak ada backup lama." -Level INFO
        }
        else {
            $TotalMB = [math]::Round(($OldBackups | Measure-Object -Property Length -Sum).Sum / 1MB, 2)
            Write-Log "Ditemukan $($OldBackups.Count) backup lama (Total: $TotalMB MB)" -Level WARNING
            foreach ($Backup in $OldBackups) {
                Remove-Item -Path $Backup.FullName -Force
                Write-Log "Dihapus: $($Backup.Name)" -Level INFO
            }
            Write-Log "Berhasil menghapus $($OldBackups.Count) backup lama." -Level SUCCESS
        }
    }
    catch {
        Write-Log "ERROR saat menghapus backup lama: $($_.Exception.Message)" -Level ERROR
    }
}

# ============================================================
# HAPUS LOG LAMA
# ============================================================
function Remove-OldLogs {
    Write-Log "====== BERSIHKAN LOG LAMA ======" -Level INFO
    try {
        $CutoffDate = (Get-Date).AddDays(-$Config.LogRetentionDays)
        $OldLogs    = Get-ChildItem -Path $Config.LogFolder -Filter "Backup_*.log" |
                      Where-Object { $_.LastWriteTime -lt $CutoffDate }

        if ($OldLogs.Count -eq 0) {
            Write-Log "Tidak ada log lama." -Level INFO
        }
        else {
            foreach ($Log in $OldLogs) {
                Remove-Item -Path $Log.FullName -Force
                Write-Log "Log dihapus: $($Log.Name)" -Level INFO
            }
            Write-Log "Berhasil menghapus $($OldLogs.Count) log lama." -Level SUCCESS
        }
    }
    catch {
        Write-Log "ERROR saat menghapus log: $($_.Exception.Message)" -Level ERROR
    }
}

# ============================================================
# UPDATE SOFTWARE VIA CHOCOLATEY
# ============================================================
function Update-Software {
    Write-Log "====== UPDATE SOFTWARE ======" -Level INFO

    if (!$Config.AutoUpdateEnabled) {
        Write-Log "Auto update DISABLED, dilewati." -Level WARNING
        return
    }

    $ChocoInstalled = Get-Command choco -ErrorAction SilentlyContinue
    if (!$ChocoInstalled) {
        Write-Log "Chocolatey tidak terinstall. Kunjungi: https://chocolatey.org/install" -Level WARNING
        return
    }

    foreach ($Software in $Config.SoftwareList) {
        Write-Log "Mengupdate $Software..." -Level INFO
        try {
            choco upgrade $Software -y --no-progress 2>&1 | Out-Null
            if ($LASTEXITCODE -eq 0) {
                Write-Log "$Software berhasil diupdate." -Level SUCCESS
            }
            else {
                Write-Log "$Software: mungkin error atau sudah versi terbaru" -Level WARNING
            }
        }
        catch {
            Write-Log "ERROR update $Software: $($_.Exception.Message)" -Level ERROR
        }
    }
}

# ============================================================
# TAMPILKAN RINGKASAN AKHIR
# ============================================================
function Show-Summary {
    param(
        [string]$ZipPath,
        [bool]$Success
    )

    $StatusText = if ($Success) { "SUKSES" } else { "GAGAL" }
    $StatusColor = if ($Success) { 'Green' } else { 'Red' }

    Write-Host ""
    Write-Host "  +--------------------------------------------------+" -ForegroundColor $StatusColor
    Write-Host "  |              RINGKASAN BACKUP                    |" -ForegroundColor White
    Write-Host "  +--------------------------------------------------+" -ForegroundColor DarkGray
    Write-Host "  | Status     : $($StatusText.PadRight(38))|" -ForegroundColor $StatusColor
    Write-Host "  | Total file : $($Script:Stats.FileCount.ToString().PadRight(38))|" -ForegroundColor Cyan
    Write-Host "  | Total size : $("$($Script:Stats.TotalSizeMB) MB".PadRight(38))|" -ForegroundColor Cyan
    Write-Host "  | Durasi     : $("$($Script:Stats.Duration) detik".PadRight(38))|" -ForegroundColor Cyan
    Write-Host "  | Errors     : $($Script:Stats.Errors.ToString().PadRight(38))|" -ForegroundColor $(if ($Script:Stats.Errors -gt 0) { 'Yellow' } else { 'Cyan' })
    if ($ZipPath) {
        $ZipName = Split-Path $ZipPath -Leaf
        Write-Host "  | File ZIP   : $($ZipName.PadRight(38))|" -ForegroundColor Cyan
    }
    Write-Host "  +--------------------------------------------------+" -ForegroundColor $StatusColor
    Write-Host ""
    Write-Host "  Lokasi backup : $($Config.BackupDestination)" -ForegroundColor White
    Write-Host "  Log tersimpan : $($Script:LogFile)" -ForegroundColor White
    Write-Host ""
    Write-Host "  -------------------------------------------------" -ForegroundColor DarkGray
    Write-Host "  Script completed! (c) By YukiiKazunomiya" -ForegroundColor Magenta
    Write-Host "  -------------------------------------------------" -ForegroundColor DarkGray
    Write-Host ""
}

# ============================================================
# MAIN PROGRAM
# ============================================================

Show-Watermark
Show-Configuration

# 1. Jalankan proses backup
$ZipPath = Start-BackupProcess

# 2. Hapus backup & log lama
Remove-OldBackups
Remove-OldLogs

# 3. Update software (opsional, default DISABLED)
Update-Software

# 4. Kirim SATU email notifikasi dengan semua attachment sekaligus
$EmailAttachments = @()
$LogCopyPath      = $null

# Buat salinan log agar tidak terkunci saat dilampirkan
if ($null -ne $Script:LogFile -and (Test-Path $Script:LogFile)) {
    $LogCopyPath = "$($Script:LogFile).tmp"
    Copy-Item $Script:LogFile $LogCopyPath -Force
    $EmailAttachments += $LogCopyPath
}

if ($null -ne $ZipPath) {
    # ── Backup SUKSES ─────────────────────────────────────
    $EmailSubject = "[Backup Sukses] $env:COMPUTERNAME - $(Get-Date -Format 'dd/MM/yyyy HH:mm')"
    $EmailBody    = "Halo,

Backup otomatis telah BERHASIL dijalankan pada komputer $env:COMPUTERNAME.

Detail Backup:
  Komputer  : $env:COMPUTERNAME
  User      : $env:USERNAME
  Waktu     : $(Get-Date -Format 'dd MMMM yyyy, HH:mm:ss')
  Total file: $($Script:Stats.FileCount) file
  Ukuran    : $($Script:Stats.TotalSizeMB) MB
  Durasi    : $($Script:Stats.Duration) detik
  Errors    : $($Script:Stats.Errors)

Folder yang dibackup:
$(($Config.BackupFolders | ForEach-Object { "  - $_" }) -join "`n")

File backup tersimpan di: $($Config.BackupDestination)

---
Backup & Maintenance Automation System v2.0
(c) 2025 YukiiKazunomiya"

    # Lampirkan ZIP jika tidak terlalu besar
    $ZipSizeMB = [math]::Round((Get-Item $ZipPath).Length / 1MB, 2)
    if ($ZipSizeMB -le $Config.MaxEmailAttachmentMB) {
        $EmailAttachments += $ZipPath
        Write-Log "ZIP akan dilampirkan ke email ($ZipSizeMB MB)" -Level INFO
    }
    else {
        Write-Log "ZIP terlalu besar ($ZipSizeMB MB > $($Config.MaxEmailAttachmentMB) MB limit), tidak dilampirkan." -Level WARNING
        $EmailBody += "`n`nCATATAN: File ZIP tidak dilampirkan karena ukurannya ($ZipSizeMB MB) melebihi batas ($($Config.MaxEmailAttachmentMB) MB). Ambil file backup langsung dari PC di: $($Config.BackupDestination)"
    }

    # Kirim 1 email saja
    Send-NotificationEmail -Subject $EmailSubject -Body $EmailBody -AttachmentPaths $EmailAttachments
    Show-Summary -ZipPath $ZipPath -Success $true

}
else {
    # ── Backup GAGAL ──────────────────────────────────────
    $EmailSubject = "[BACKUP GAGAL] $env:COMPUTERNAME - $(Get-Date -Format 'dd/MM/yyyy HH:mm')"
    $EmailBody    = "PERHATIAN: Backup GAGAL pada komputer $env:COMPUTERNAME!

Detail:
  Komputer : $env:COMPUTERNAME
  User     : $env:USERNAME
  Waktu    : $(Get-Date -Format 'dd MMMM yyyy, HH:mm:ss')

Silakan cek log yang terlampir untuk mengetahui penyebab kegagalan.
Log tersimpan di: $($Script:LogFile)

---
Backup & Maintenance Automation System v2.0
(c) 2025 YukiiKazunomiya"

    Send-NotificationEmail -Subject $EmailSubject -Body $EmailBody -AttachmentPaths $EmailAttachments
    Show-Summary -ZipPath $null -Success $false
}

# Hapus file log sementara
if ($null -ne $LogCopyPath -and (Test-Path $LogCopyPath)) {
    Remove-Item $LogCopyPath -Force -ErrorAction SilentlyContinue
}

Write-Log "====== PROSES SELESAI ======" -Level SUCCESS
